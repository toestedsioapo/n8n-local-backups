    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst first = $input.all().map(i => i.json).sort((a, b) => a.pos - b.pos)[0];\nconst due = DateTime.fromISO(cfg.kickoffStart).toUTC().toISO();\nreturn [{ json: { body: { idList: first.id, name: `Onboarding checklist - ${cfg.label}`, desc: `Kickoff: ${cfg.kickoffStart}\\nDrive: ${$('Drive: Create Client Folder').first().json.webViewLink}${cfg.notes ? `\\n\\nNotes: ${cfg.notes}` : ''}`, due, pos: 'top' } } }];"
