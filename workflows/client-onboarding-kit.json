        "jsCode": "const cfg = $('Config').first().json;\nconst links = {\n  drive: $('Drive: Create Client Folder').first().json.webViewLink,\n  trello: $('Trello: Create Board').first().json.url,\n  kickoff: $('Calendar: Kickoff Hold').first().json.htmlLink,\n};\nreturn [{ json: { ...links, label: cfg.label, sheetId: cfg.CLIENTS_SHEET_ID,\n  sheetRow: [$now.setZone(cfg.TZ).toISODate(), cfg.client, cfg.company, cfg.email, cfg.service, cfg.startDate, links.drive, links.trello],\n  text: `:handshake: New client set up: *${cfg.label}* (${cfg.service}, starts ${cfg.startDate})\\n- Drive: ${links.drive}\\n- Trello: ${links.trello}\\n- Kickoff hold: ${links.kickoff}\\n- Welcome email saved to Gmail drafts` } }];"
