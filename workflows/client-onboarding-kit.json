    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nreturn [{ json: { body: {\n  summary: `HOLD: Kickoff - ${cfg.label}`,\n  description: `Kickoff call with ${cfg.client} <${cfg.email}> (${cfg.service}).\\nConfirm the time with the client, then add them as a guest.\\n\\nDrive: ${$('Drive: Create Client Folder').first().json.webViewLink}\\nTrello: ${$('Trello: Create Board').first().json.url}${cfg.notes ? `\\n\\nNotes: ${cfg.notes}` : ''}`,\n  start: { dateTime: cfg.kickoffStart, timeZone: cfg.TZ },\n  end: { dateTime: cfg.kickoffEnd, timeZone: cfg.TZ },\n  transparency: 'opaque',\n} } }];"
      },
