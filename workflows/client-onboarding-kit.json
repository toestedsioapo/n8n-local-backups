          "name": "Google Calendar account"
        }
      },
      "id": "2fffb759-3fc6-527a-bc6e-80f2ec441424"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst first = cfg.client.split(/\\s+/)[0] || 'there';\nconst kickoff = DateTime.fromISO(cfg.kickoffStart).setZone(cfg.TZ).toFormat(\"cccc, LLLL d 'at' h:mm a\");\nconst body = [\n  `Hi ${first},`,\n  '',\n  `Welcome aboard! I'm excited to start working with you${cfg.company ? ` and the ${cfg.company} team` : ''} on ${String(cfg.service).toLowerCase() || 'your project'}.`,\n  '',\n  'Here is what happens next:',\n  `1. Kickoff call - I've pencilled in ${kickoff} (${cfg.TZ.replace('_', ' ')} time).${cfg.SCHEDULING_LINK ? ` If that doesn't work, pick another slot here: ${cfg.SCHEDULING_LINK}` : ' Let me know if another time works better.'}`,\n  '2. Access - I will send a short list of the accounts and tools I need.',\n  '3. Weekly check-in - we will agree on a regular time to review priorities.',\n  '',\n  'Feel free to reply with any questions before then.',\n  '',\n  'Best regards,',\n  cfg.EXEC_NAME,\n].join('\\r\\n');\nconst b64 = s => Buffer.from(s, 'utf8').toString('base64');\nconst subject = `Welcome${cfg.company ? `, ${cfg.company}` : ''} - next steps`;\nconst mime = [`To: ${cfg.email}`, `Subject: =?UTF-8?B?${b64(subject)}?=`, 'MIME-Version: 1.0', 'Content-Type: text/plain; charset=\"UTF-8\"', 'Content-Transfer-Encoding: base64'].join('\\r\\n') + '\\r\\n\\r\\n' + b64(body);\nconst raw = Buffer.from(mime, 'utf8').toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\nreturn [{ json: { draftBody: { message: { raw } } } }];"
      },
